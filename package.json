{
  "name": "@lopatnov/callable",
  "version": "3.0.0",
  "license": "Apache-2.0",
  "author": "lopatnov",
  "description": "Make TypeScript/JavaScript class instances callable as functions. Four implementation strategies: bind, closure, proxy, and callee.",
  "homepage": "https://lopatnov.github.io/callable/",
  "keywords": [
    "callable",
    "abstract-class",
    "function",
    "typescript",
    "javascript",
    "proxy",
    "bind",
    "closure",
    "functor",
    "typescript-library"
  ],
  "umdName": "callable",
  "main": "dist/byBind.cjs",
  "module": "dist/byBind.esm.mjs",
  "types": "dist/byBind.d.ts",
  "exports": {
    "./byBind": {
      "types": "./dist/byBind.d.ts",
      "import": "./dist/byBind.esm.mjs",
      "require": "./dist/byBind.cjs",
      "browser": "./dist/byBind.umd.js",
      "default": "./dist/byBind.umd.js"
    },
    "./byCallee": {
      "types": "./dist/byCallee.d.ts",
      "import": "./dist/byCallee.esm.mjs",
      "require": "./dist/byCallee.cjs",
      "browser": "./dist/byCallee.umd.js",
      "default": "./dist/byCallee.umd.js"
    },
    "./byClosure": {
      "types": "./dist/byClosure.d.ts",
      "import": "./dist/byClosure.esm.mjs",
      "require": "./dist/byClosure.cjs",
      "browser": "./dist/byClosure.umd.js",
      "default": "./dist/byClosure.umd.js"
    },
    "./byProxy": {
      "types": "./dist/byProxy.d.ts",
      "import": "./dist/byProxy.esm.mjs",
      "require": "./dist/byProxy.cjs",
      "browser": "./dist/byProxy.umd.js",
      "default": "./dist/byProxy.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lopatnov/callable.git"
  },
  "bugs": {
    "url": "https://github.com/lopatnov/callable/issues"
  },
  "scripts": {
    "build": "rollup -c rollup.config.mjs",
    "watch": "rollup -cw rollup.config.mjs",
    "test": "jest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "configure-npm": "node ./set-registry.js -s https://registry.npmjs.org",
    "configure-gpr": "node ./set-registry.js -s https://npm.pkg.github.com"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.0.0",
    "@lopatnov/rollup-plugin-uglify": "^4.0.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-json": "^6.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.0.0",
    "rollup": "^4.0.0",
    "ts-jest": "^29.0.0",
    "tslib": "^2.6.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
